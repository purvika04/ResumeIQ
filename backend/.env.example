# ResumeIQ Backend Environment Variables

# Application
PROJECT_NAME=ResumeIQ
ENV=development
DEBUG=True

# Relational Database (Supabase PostgreSQL or SQLite)
# For local SQLite fallback (default):
DATABASE_URL=sqlite:///./data/resumeiq.db
# For Supabase PostgreSQL:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Document Store (MongoDB or Local File JSON Store)
# Leave blank for local JSON store fallback (default):
MONGODB_URI=
MONGODB_DB_NAME=resumeiq_db
# For remote MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority

# File Paths
DOCUMENT_STORE_DIR=./data/document_store
UPLOADS_DIR=./data/uploads

# AI / ML Settings
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Default Scoring Weights (Must sum to 1.0)
WEIGHT_SEMANTIC=0.40
WEIGHT_REQUIRED_SKILLS=0.35
WEIGHT_PREFERRED_SKILLS=0.15
WEIGHT_EXPERIENCE=0.10
